[{"short_id":"rwloew","created_at":"2026-10-06T03:09:53.070-05:00","title":"Email Self Hosters - what are you using?","url":"","score":59,"flags":0,"comment_count":60,"description":"\u003cp\u003eAt the moment I self host using \u003ca href=\"https://maddy.email\" rel=\"ugc\"\u003emaddy\u003c/a\u003e for a bunch of domains that need a mailbox or catch all. There are some minor issues with it - some are me, some are who knows. The biggest bug bear is that the native email client on iOS takes an age to connect and download messages which causes some issues with OTP emails.\u003c/p\u003e\n\u003cp\u003eSo for those out there that do host their own email - what are you running, what would you change?\u003c/p\u003e\n","description_plain":"At the moment I self host using [maddy](https://maddy.email) for a bunch of domains that need a mailbox or catch all. There are some minor issues with it - some are me, some are who knows. The biggest bug bear is that the native email client on iOS takes an age to connect and download messages which causes some issues with OTP emails.  \r\n\r\nSo for those out there that do host their own email - what are you running, what would you change?","submitter_user":"vetch","user_is_author":true,"tags":["ask","email"],"short_id_url":"https://lobste.rs/s/rwloew","comments_url":"https://lobste.rs/s/rwloew/email_self_hosters_what_are_you_using"},{"short_id":"gveu0c","created_at":"2026-10-06T04:07:39.717-05:00","title":"Montray - a tray icon for systemd service health","url":"https://github.com/dimonomid/montray/","score":26,"flags":0,"comment_count":3,"description":"","description_plain":"","submitter_user":"dimonomid","user_is_author":true,"tags":["linux","systemd"],"short_id_url":"https://lobste.rs/s/gveu0c","comments_url":"https://lobste.rs/s/gveu0c/montray_tray_icon_for_systemd_service"},{"short_id":"okk4bg","created_at":"2026-10-05T13:31:29.400-05:00","title":"Async Rust: Where does the scheduler live?","url":"https://herecomesthemoon.net/2026/