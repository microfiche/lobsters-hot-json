[{"short_id":"0typpq","created_at":"2026-08-24T11:04:45.869-05:00","title":"I cannot survive from burnout","url":"","score":188,"flags":3,"comment_count":73,"description":"\u003cp\u003eI burned out two years ago, went through a divorce, and relocated to a new city. I live alone now and care for seven cats.\u003c/p\u003e\n\u003cp\u003eOver the last two years, I’ve tried forcing discipline, making detailed plans, and restarting over and over. Despite this, I’m still carrying significant debt.\u003c/p\u003e\n\u003cp\u003eMy main struggle is staying focused on paid work. I’m constantly building and working on my own side projects, but I struggle to put time into client work. Because of my experience, finding clients isn't hard, but I tend to lose them after a few months due to low throughput. I deliver high-quality code and solve their core problems, but I can only bring myself to work on client tasks for about 5–6 hours a week.\u003c/p\u003e\n\u003cp\u003eI’m struggling to survive day-to-day and losing hope that this will change, though some days are good and I can get solid work done. I’ve tried all the standard advice for burnout with little success. At this point, I wonder if burnout has become a habit, an excuse, or a form of self-sabotage.\u003c/p\u003e\n\u003cp\u003eI’m posting here to see if anyone who has experienced something similar found a practical way out or a working routine that stuck.\u003c/p\u003e\n","description_plain":"I burned out two years ago, went through a divorce, and relocated to a new city. I live alone now and care for seven cats.\r\n\r\nOver the last two years, I’ve tried forcing discipline, making detailed plans, and restarting over and over. Despite this, I’m still carrying significant debt.\r\n\r\nMy main struggle is staying focused on paid work. I’m constantly building and working on my own side projects, but I struggle to put time into client work. Because of my experience, finding clients isn't hard, but I tend to lose them after a few months due to low throughput. I deliver high-quality code and solve their core problems, but I can only bring myself to work on client tasks for about 5–6 hours a week.\r\n\r\nI’m struggling to survive day-to-day and losing hope that this will change, though some days are good and I can get solid work done. I’ve tried all the standard advice for burnout with little success. At this point, I wonder if burnout has become a habit, an excuse, or a form of self-sabotage.\r\n\r\nI’m posting here to see if anyone who has experienced something similar found a practical way out or a working routine that stuck.","submitter_user":"delirehberi","user_is_author":true,"tags":["person"],"short_id_url":"https://lobste.rs/s/0typpq","comments_url":"https://lobste.rs/s/0typpq/i_cannot_survive_from_burnout"},{"short_id":"jjspxh","created_at":"2026-08-25T06:16:01.500-05:00","title":"MNT Station - A modular, open hardware desktop computer and server","url":"https://www.crowdsupply.com/mnt-research/mnt-station","score":18,"flags":1,"comment_count":7,"description":"","description_plain":"","submitter_user":"hawski","user_is_author":false,"tags":["hardware"],"short_id_url":"https://lobste.rs/s/jjspxh","comments_url":"https://lobste.rs/s/jjspxh/mnt_station_modular_open_hardware"},{"short_id":"ivr1bw","created_at":"2026-08-25T07:06:16.154-05:00","title":"An interactive introduction to the spanning tree protocol","url":"https://vincent.bernat.ch/en/blog/2026-spanning-tree","score":9,"flags":0,"comment_count":3,"description":"","description_plain":"","submitter_user":"vbernat","user_is_author":true,"tags":["networking"],"short_id_url":"https://lobste.rs/s/ivr1bw","comments_url":"https://lobste.rs/s/ivr1bw/interactive_introduction_spanning_tree"},{"short_id":"26oj2u","created_at":"2026-08-24T11:25:08.134-05:00","title":"Intent to Ship: JPEG XL","url":"https://hacks.mozilla.org/2026/08/intent-to-ship-jpeg-xl/","score":84,"flags":0,"comment_count":15,"description":"","description_plain":"","subm